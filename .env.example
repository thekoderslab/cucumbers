# Copy to .env.local for local development, and add the same two variables in
# Vercel under Settings → Environment Variables.
#
# Both are SERVER-ONLY. Do not add a NEXT_PUBLIC_ prefix to either — the
# service role key bypasses row-level security, and prefixing it would inline
# it into the JavaScript bundle sent to every visitor.
#
# Find both in Supabase: Dashboard → Project Settings → API.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
